# Copy to .env.local. Server-side only — used by the /api/tenant and /api/ocr proxy
# routes, never shipped to the browser.

# Base URL of the Heirs OCR API. Required — the server refuses to start without it
# (src/instrumentation.ts). Include the scheme: `fetch` cannot parse a bare host:port.
OCR_API_URL=http://localhost:8080

# Local dev only. The /api/ocr/* routes sit outside the portal's auth gate, so by
# default an unauthenticated request is rejected with 401 rather than falling back to
# the shared key below — otherwise anyone who can reach this origin could run
# documents billed to whichever tenant owns that key. Set to "true" ONLY against a
# local backend running with AUTH_ENABLED=false. Never set this in a deployed env.
OCR_ALLOW_ANONYMOUS=

# Shared API key used only when OCR_ALLOW_ANONYMOUS=true. In a real deployment the
# proxy forwards the signed-in tenant's session instead, so leave this empty.
OCR_API_KEY=

# The API host printed in the public documentation (/api-reference, /sdks) — what a
# customer calls, which is not necessarily the address above. Left unset, the docs
# show a neutral placeholder rather than leaking the internal name in OCR_API_URL.
OCR_PUBLIC_API_URL=
