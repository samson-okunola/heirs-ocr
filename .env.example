# Copy to .env and fill in. Validated by src/config/env.ts at startup.
# Do NOT commit the real .env (it is gitignored).

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Redis (extraction cache + BullMQ queue + rate limiter + admin sessions) ---
# REQUIRED — no default in code; env.ts throws if unset. Passed straight through to
# containers (docker compose reads this file via `env_file`). Use `rediss://` for TLS.
#   managed:                 rediss://default:<pass>@<host>:<port>
#   local (pnpm dev):        redis://localhost:6379
#   docker compose --profile local-infra:  redis://redis:6379  (in-network service name)
REDIS_URL=redis://localhost:6379

# --- Postgres (durable data: tenants/API-key registry, admin users, usage) ---
# REQUIRED — no default in code. Schema is created idempotently on startup (src/db.ts).
# Full connection string, passed straight through (add `?sslmode=require` for managed TLS).
#   managed:                 postgres://<user>:<pass>@<host>:5432/<db>?sslmode=require
#   local (pnpm dev):        postgres://<user>:<pass>@localhost:5432/heirs_ocr
#   docker compose --profile local-infra:  postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heirs_ocr

# Boot-time ceilings for the first connection to each store (ms). They bound the
# handshake only — nothing waits on them once a connection is up — so the defaults
# are deliberately generous. Managed remote instances need seconds (TCP + TLS +
# auth across a region), where a local server connects in milliseconds.
# DB_CONNECT_TIMEOUT_MS=30000
# REDIS_CONNECT_TIMEOUT_MS=30000

# --- Auth (Postgres-backed API keys) ---
# AUTH_ENABLED=false bypasses auth entirely — LOCAL DEV ONLY, never in prod.
AUTH_ENABLED=true
API_KEY_CACHE_TTL_SECONDS=30

# --- Admin console (/admin) ---
# Operator UI for tenant management + observability. Admin users live in Postgres.
# The first owner is seeded automatically on startup when the registry is empty
# (idempotent) — change the password after first login. Session lifetime:
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_BOOTSTRAP_EMAIL=samson.okunola@heirstechnologies.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@1234#

# --- CORS (server-to-server: default closed) ---
# Comma-separated browser origins to allow. Empty = no cross-origin browser
# access (backends are unaffected). Never uses "*".
CORS_ALLOWED_ORIGINS=

# --- Rate limiting (per tenant, fixed window; fails open if Redis is down) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Observability ---
# When set, GET /metrics requires `Authorization: Bearer <token>`. Leave unset only
# if the port is on a private, scrape-only network. Warned about at boot in prod.
METRICS_AUTH_TOKEN=
# Estimated LLM price in NGN per 1,000 tokens → ocr_estimated_cost_ngn_total. 0 = off.
LLM_COST_NGN_PER_1K_TOKENS=0
# Result confidence at or below this (0–1) counts as "low" for the quality SLI.
LOW_CONFIDENCE_THRESHOLD=0.7

# --- Upload / async thresholds ---
MAX_FILE_SIZE_BYTES=52428800
ASYNC_PAGE_THRESHOLD=5
ASYNC_SIZE_THRESHOLD_BYTES=5242880
EXTRACTION_CACHE_TTL_SECONDS=604800

# --- Azure OpenAI (interpretation layer) ---
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- GLM-OCR (layout-aware extraction) ---
GLM_ENABLED=false
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MAX_PAGES=30
GLM_CONCURRENCY=8

# --- Background work ---
# Whether this process also runs the OCR queue worker, the retention sweep and
# webhook delivery. Defaults to `true` so a single container is a complete service —
# a bare `docker run` of this image is not silently missing every background feature.
# Set `false` ONLY on the web process when a dedicated worker container is deployed
# alongside it (docker-compose.yml does this). Running both is safe: the sweep takes a
# Redis lock, webhook delivery claims rows with SKIP LOCKED, and BullMQ locks jobs.
# RUN_BACKGROUND_WORKERS=true

# --- Object storage for processed documents (S3-compatible) ---
# OFF by default: keeping the source file is a different privacy posture from the
# metadata-only document registry, so it has to be switched on deliberately.
# Documents run through pii/restricted functions are never archived either way.
# Locally, `docker compose up` starts MinIO and creates the bucket for you.
BLOB_STORAGE_ENABLED=false
# Empty for real AWS S3; http://minio:9000 in the compose network (http://localhost:9000 from the host).
S3_ENDPOINT=
S3_BUCKET=heirs-ocr-documents
S3_REGION=us-east-1
# Leave both blank on AWS to use the instance role / ambient credential chain.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO requires path-style addressing; real S3 works either way.
S3_FORCE_PATH_STYLE=true
# Presigned download links are bearer URLs — keep the window short.
S3_DOWNLOAD_URL_TTL_SECONDS=300
# Host ports for the bundled MinIO (API + browser console).
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_PORT=9001

VERSION=1.0.0

# --- Docker Compose `local-infra` profile only ---
# Credentials for the OPTIONAL bundled `postgres` container, started only with
# `docker compose --profile local-infra up`. These are DISPOSABLE local-dev creds,
# not the app's real database (that's DATABASE_URL above) — leave the defaults or
# override. When using local-infra, also point DATABASE_URL/REDIS_URL at the
# in-network service names (see their notes above). Omit this block entirely if you
# run against managed Redis/Postgres.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=heirs_ocr

# --- Transactional email (src/notification/mail) ---
# Off by default. With it off, every sender no-ops and logs, so signups, job
# completions and billing events still succeed against an unconfigured relay.
# Turning it on makes SMTP_HOST and MAIL_FROM_ADDRESS required at boot — the
# service refuses to start half-configured rather than failing at first send.
MAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
# 587 with STARTTLS (leave SMTP_SECURE=false), or 465 for implicit TLS
# (SMTP_SECURE=true). Setting `secure` on 587 hangs the handshake.
SMTP_PORT=587
SMTP_SECURE=false
# Omit both to let a relay authenticate this host by IP instead.
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Must be an address/domain the relay is authorised to send for —
# with Brevo that means a verified sender or an authenticated domain, otherwise
# messages are rejected or land in spam.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Heirs Technologies

# Public base URL of the tenant console. Every email template links back to it, so
# it must be an address recipients can actually reach, not an internal hostname.
APP_BASE_URL=http://localhost:8080
# Public base URL of this API, quoted to new tenants in their welcome email as the
# host to point an SDK at. Distinct from APP_BASE_URL, which is the console.
API_BASE_URL=http://localhost:8080
# Linked from the footer of every email.
DOCS_URL=https://docs.heirstechnologies.com
SUPPORT_EMAIL=support@heirstechnologies.com

# ── Self-service sign-up ─────────────────────────────────────────────────────
# Whether anyone may create an organisation from the portal's register page. Set to
# false for a deployment where every org is provisioned by an operator through the
# admin console; POST /tenant/api/register then answers 403.
#
# Note that a sign-up cannot be completed at all unless MAIL_ENABLED is true — the
# code is only delivered by email. Outside production, with mail off, the code is
# written to the log stream instead so local development still works.
SELF_SIGNUP_ENABLED=true
